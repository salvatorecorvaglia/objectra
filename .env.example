# ──────────────────────────────────────────────────────────────────────
# Objectra Environment Configuration Template
# ──────────────────────────────────────────────────────────────────────
# Copy this file to '.env' and modify the values for your environment.
#
#   cp .env.example .env
#
# ⚠️ WARNING: Change the default credentials before running in production!

# ──────────────────────────────────────────────────────────────────────
# Core Server Configuration
# ──────────────────────────────────────────────────────────────────────

# S3 access key used for authentication
OBJECTRA_ACCESS_KEY=objectra

# S3 secret key used for authentication
OBJECTRA_SECRET_KEY=objectra123

# Root directory for storing buckets and objects
OBJECTRA_DATA_DIR=./data

# Port the S3 API server listens on
OBJECTRA_S3_PORT=9000

# Port the web console listens on
OBJECTRA_CONSOLE_PORT=9001

# S3 region reported by the server
OBJECTRA_REGION=us-east-1

# Base domain used for virtual host S3 bucket routing (e.g., bucket.domain.com)
# OBJECTRA_DOMAIN=

# Custom public S3 endpoint URL (e.g., https://s3.example.com) used when
# generating presigned object URLs in the Console. Overrides request-host resolution.
# OBJECTRA_S3_ENDPOINT=

# ──────────────────────────────────────────────────────────────────────
# SSL / TLS Configuration
# ──────────────────────────────────────────────────────────────────────

# Enable to serve S3 API and Console over HTTPS/TLS (requires Cert and Key files)
# OBJECTRA_TLS_ENABLED=false
# OBJECTRA_TLS_CERT=
# OBJECTRA_TLS_KEY=

# ──────────────────────────────────────────────────────────────────────
# Console Security & Rate Limiting
# ──────────────────────────────────────────────────────────────────────

# JWT secret key used for console session authentication.
# Persistent signing key preserves user sessions across server restarts.
# If left blank, a random secret is generated on startup.
# OBJECTRA_JWT_SECRET=yoursecretkeyhere

# Trust client's X-Forwarded-For header for rate limiting (when running behind a proxy like Nginx/Caddy/Cloudflare)
# OBJECTRA_TRUST_PROXY=false

# Maximum console login requests allowed per minute per IP
# OBJECTRA_LOGIN_RATE_LIMIT=5

# Maximum console API requests allowed per minute per IP
# OBJECTRA_API_RATE_LIMIT=60

# ──────────────────────────────────────────────────────────────────────
# Logging & Debugging
# ──────────────────────────────────────────────────────────────────────

# Output log verbosity (debug, info, warn, error)
# OBJECTRA_LOG_LEVEL=info

# Logger format (text or json)
# OBJECTRA_LOG_FORMAT=text

# Disable the S3 5MB minimum multipart size limitation (useful for testing)
# OBJECTRA_DISABLE_MIN_PART_SIZE=false

# ──────────────────────────────────────────────────────────────────────
# Active-Passive Mirroring (Asynchronous replication)
# ──────────────────────────────────────────────────────────────────────

# Endpoint URL of the replication destination (e.g., https://s3.eu-west-1.amazonaws.com)
# OBJECTRA_SYNC_ENDPOINT=

# Target bucket name at the replication destination
# OBJECTRA_SYNC_BUCKET=

# Access Key of the replication target credentials
# OBJECTRA_SYNC_ACCESS_KEY=

# Secret Key of the replication target credentials
# OBJECTRA_SYNC_SECRET_KEY=

# Region of the replication target credentials
# OBJECTRA_SYNC_REGION=us-east-1

# ──────────────────────────────────────────────────────────────────────
# Webhook Event Notifications
# ──────────────────────────────────────────────────────────────────────

# Destination POST endpoint to receive webhook notifications (e.g., http://my-service/events)
# OBJECTRA_WEBHOOK_URL=
