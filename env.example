# ──────────────────────────────────────────────────────────────────────
# Objectra Environment Configuration Template
# ──────────────────────────────────────────────────────────────────────
# Copy this file to '.env' and modify the values for your environment.
#
#   cp env.example .env
#
# ⚠️ WARNING: Change the default credentials before running in production!

# S3 access key used for authentication
OBJECTRA_ACCESS_KEY=objectra

# S3 secret key used for authentication
OBJECTRA_SECRET_KEY=objectra123

# Root directory for storing buckets and objects
OBJECTRA_DATA_DIR=./data

# Port the S3 API server listens on
OBJECTRA_S3_PORT=9000

# Port the web console listens on
OBJECTRA_CONSOLE_PORT=9001

# S3 region reported by the server
OBJECTRA_REGION=us-east-1
